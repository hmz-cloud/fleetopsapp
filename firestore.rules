rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Retrieve the user document using their email address (from auth token)
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    // Match global users collection
    match /users/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (email == request.auth.token.email || getUserDoc().data.role == 'admin');
    }

    // Match all multi-tenant paths
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if isSignedIn() && (
        getUserDoc() != null && getUserDoc().data.org == tenantId
      );
    }
  }
}
